{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyApp",
  "version": "0.1.0",
  "identifier": "com.example.myapp",
  "build": {
    "beforeDevCommand": "node scripts/build-sidecar.ts && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-sidecar.ts && pnpm build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MyApp",
        "width": 480,
        "height": 360,
        "minWidth": 360,
        "minHeight": 280,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/myapp-cli"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
