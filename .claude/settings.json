{
  "permissions": {
    "allow": [
      "Bash(just check)",
      "Bash(just check-harness)",
      "Bash(just verify-hooks)",
      "Bash(just fmt)",
      "Bash(just fix)",
      "Bash(just lint)",
      "Bash(just test)",
      "Bash(just test-core)",
      "Bash(just test-ui)",
      "Bash(just test-scripts)",
      "Bash(just test-fast:*)",
      "Bash(just test-macos)",
      "Bash(just bindings)",
      "Bash(just sidecar)",
      "Bash(just sidecar:*)",
      "Bash(just build)",
      "Bash(just smoke)",
      "Bash(just logs)",
      "Bash(just deny)",
      "Bash(just clean)",
      "Bash(just prune-temp)",
      "Bash(just prune-temp:*)",
      "Bash(just agents-sync)",
      "Bash(just agents-check)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(gh api -X GET:*)",
      "Bash(gh api --method GET:*)"
    ],
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git commit * --no-verify)",
      "Bash(git commit * --no-verify *)",
      "Bash(git commit --no-v*)",
      "Bash(git commit * --no-v*)",
      "Bash(git commit -n:*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git push --force:*)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f:*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push * --force-with-lease)",
      "Bash(git push * --force-with-lease *)",
      "Bash(git push --force-with-lease=*)",
      "Bash(git push * --force-with-lease=*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(LEFTHOOK=*)",
      "Bash(* LEFTHOOK=*)",
      "Bash(LEFTHOOK_EXCLUDE=*)",
      "Bash(* LEFTHOOK_EXCLUDE=*)",
      "Bash(LEFTHOOK_BIN=*)",
      "Bash(* LEFTHOOK_BIN=*)",
      "Bash(LEFTHOOK_CONFIG=*)",
      "Bash(* LEFTHOOK_CONFIG=*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git * -c core.hooksPath*)",
      "Bash(git --config-env=core.hooksPath*)",
      "Bash(git * --config-env=core.hooksPath*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git config * core.hooksPath*)",
      "Bash(gh api -X GET -X*)",
      "Bash(gh api -X GET * -X*)",
      "Bash(gh api -X GET --method*)",
      "Bash(gh api -X GET * --method*)",
      "Bash(gh api --method GET -X*)",
      "Bash(gh api --method GET * -X*)",
      "Bash(gh api --method GET --method*)",
      "Bash(gh api --method GET * --method*)",
      "Bash(gh pr view --web*)",
      "Bash(gh pr view * --web*)",
      "Bash(gh pr view -w:*)",
      "Bash(gh pr view * -w)",
      "Bash(gh pr view * -w *)",
      "Bash(gh pr list --web*)",
      "Bash(gh pr list * --web*)",
      "Bash(gh pr list -w:*)",
      "Bash(gh pr list * -w)",
      "Bash(gh pr list * -w *)",
      "Bash(gh pr checks --web*)",
      "Bash(gh pr checks * --web*)",
      "Bash(gh pr checks -w:*)",
      "Bash(gh pr checks * -w)",
      "Bash(gh pr checks * -w *)",
      "Bash(gh pr diff --web*)",
      "Bash(gh pr diff * --web*)",
      "Bash(gh pr diff -w:*)",
      "Bash(gh pr diff * -w)",
      "Bash(gh pr diff * -w *)",
      "Bash(gh issue view --web*)",
      "Bash(gh issue view * --web*)",
      "Bash(gh issue view -w:*)",
      "Bash(gh issue view * -w)",
      "Bash(gh issue view * -w *)",
      "Bash(gh issue list --web*)",
      "Bash(gh issue list * --web*)",
      "Bash(gh issue list -w:*)",
      "Bash(gh issue list * -w)",
      "Bash(gh issue list * -w *)",
      "Bash(gh run view --web*)",
      "Bash(gh run view * --web*)",
      "Bash(gh run view -w:*)",
      "Bash(gh run view * -w)",
      "Bash(gh run view * -w *)",
      "Edit(/src-tauri/Entitlements.plist)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && mise exec -- node scripts/format-edited-file.ts"
          }
        ]
      }
    ]
  }
}
