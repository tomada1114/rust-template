{
  "permissions": {
    "allow": [
      "Bash(just check)",
      "Bash(just check-harness)",
      "Bash(just verify-hooks)",
      "Bash(just fmt)",
      "Bash(just fix)",
      "Bash(just lint)",
      "Bash(just test)",
      "Bash(just test-core)",
      "Bash(just test-ui)",
      "Bash(just test-scripts)",
      "Bash(just test-fast:*)",
      "Bash(just test-macos)",
      "Bash(just bindings)",
      "Bash(just sidecar)",
      "Bash(just sidecar:*)",
      "Bash(just build)",
      "Bash(just smoke)",
      "Bash(just logs)",
      "Bash(just deny)",
      "Bash(just agents-sync)",
      "Bash(just agents-check)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(gh api -X GET:*)",
      "Bash(gh api --method GET:*)"
    ],
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git commit * --no-verify)",
      "Bash(git commit * --no-verify *)",
      "Bash(git commit -n:*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git push --force:*)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f:*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push * --force-with-lease)",
      "Bash(git push * --force-with-lease *)",
      "Bash(git push --force-with-lease=*)",
      "Bash(git push * --force-with-lease=*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Edit(/src-tauri/Entitlements.plist)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && mise exec -- node scripts/format-edited-file.ts"
          }
        ]
      }
    ]
  }
}
