{
  "name": "myapp",
  "version": "0.1.0",
  "private": true,
  "description": "MyApp: a macOS desktop app built with Tauri v2, a Rust core, and a React UI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite",
    "build:ui": "tsc -p ui/tsconfig.json && vite build",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json && tsc -p scripts/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ui": "vitest run --project ui --reporter=verbose --coverage --coverage.include='ui/src/**/*.{ts,tsx}'",
    "test:scripts": "vitest run --project scripts --coverage --coverage.include='scripts/**/*.ts' --coverage.include='.agents/skills/*/scripts/**/*.ts'"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "~2.11.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "jsdom": "^30.1.0",
    "prettier": "~3.9.8",
    "smol-toml": "^1.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.70.0",
    "vite": "^8.3.0",
    "vitest": "~5.0.1",
    "yaml": "^2.9.0"
  }
}
